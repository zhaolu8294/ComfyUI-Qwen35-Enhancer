# 仓库内统一用 LF，避免 Windows 检出成 CRLF 后整片换行混进 diff
* text=auto eol=lf

# 图片与权重是二进制，禁止任何换行符转换
*.png        binary
*.jpg        binary
*.jpeg       binary
*.webp       binary
*.bmp        binary
*.safetensors binary

# Windows 脚本必须 CRLF，否则双击 / cmd 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf

# 示例工作流 JSON 频繁被 ComfyUI 重写，diff 里不显示成二进制
*.json text eol=lf

# GitHub Actions 的 YAML 必须是 LF
*.yml  text eol=lf
*.yaml text eol=lf
